<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;"
            stylesheets="@../css/flowstate-theme.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.flowstate.ui.DashboardController">

    <VBox spacing="20.0" styleClass="content-area">
        <padding>
            <Insets bottom="32.0" left="28.0" right="28.0" top="16.0"/>
        </padding>

        <!-- Top Greeting Header (Deep Focus Style) -->
        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label fx:id="lblGreeting" styleClass="view-title" text="Good day!"/>
                <Label fx:id="lblCurrentDate" styleClass="view-subtitle" text="Today is Monday, October 26, 2026"/>
            </VBox>
            <Label styleClass="date-pill" text="⚡ Real-Time Tracking Active"/>
        </HBox>

        <!-- Daily Goal Progress Card -->
        <VBox spacing="8.0" styleClass="card">
            <HBox alignment="CENTER_LEFT">
                <Label styleClass="card-title" text="Daily Productive Focus Goal"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblGoalProgressText" style="-fx-font-weight: bold; -fx-text-fill: #A78BFA;" text="0 / 120 mins (0%)"/>
            </HBox>
            <ProgressBar fx:id="pbDailyGoal" maxWidth="Infinity" progress="0.0"/>
        </VBox>

        <!-- 4 Key Stat Metric Cards -->
        <GridPane hgap="16.0" vgap="16.0">
            <!-- Card 1: Today Productive Time -->
            <VBox spacing="8.0" styleClass="card" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="card-title" text="Productive Time"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label styleClass="card-icon" text="⏱"/>
                </HBox>
                <Label fx:id="lblTodayFocusTime" styleClass="card-value" text="0m"/>
                <Label styleClass="card-subtext" text="In productive tools"/>
            </VBox>

            <!-- Card 2: Active Apps Count -->
            <VBox spacing="8.0" styleClass="card" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="card-title" text="Active Apps"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label styleClass="card-icon" text="💻"/>
                </HBox>
                <Label fx:id="lblActiveAppsCount" styleClass="card-value" text="0"/>
                <Label styleClass="card-subtext" text="Tracked applications"/>
            </VBox>

            <!-- Card 3: Distracting Time -->
            <VBox spacing="8.0" styleClass="card" GridPane.columnIndex="2" GridPane.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="card-title" text="Distraction Time"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label styleClass="card-icon" text="⚠️"/>
                </HBox>
                <Label fx:id="lblDistractingTime" styleClass="card-value" style="-fx-text-fill: #F87171;" text="0m"/>
                <Label styleClass="card-subtext" text="In distracting apps"/>
            </VBox>

            <!-- Card 4: Focus Ratio -->
            <VBox spacing="8.0" styleClass="card" GridPane.columnIndex="3" GridPane.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="card-title" text="Focus Ratio"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label styleClass="card-icon" text="↗"/>
                </HBox>
                <Label fx:id="lblFocusRatio" styleClass="card-value" style="-fx-text-fill: #10B981;" text="0%"/>
                <Label styleClass="card-subtext" text="Productive percentage"/>
            </VBox>
        </GridPane>

        <!-- Charts and Top Apps Split -->
        <HBox spacing="16.0">
            <!-- 7-Day Focus Time Bar Chart -->
            <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS" prefWidth="540.0">
                <Label styleClass="card-title" text="WEEKLY PRODUCTIVE VOLUME (MINUTES)"/>
                <BarChart fx:id="chartWeeklyFocus" animated="false" legendVisible="false" prefHeight="240.0">
                    <xAxis>
                        <CategoryAxis fx:id="axisDays" side="BOTTOM"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="axisMinutes" label="Minutes" side="LEFT"/>
                    </yAxis>
                </BarChart>
            </VBox>

            <!-- Most-Used Applications -->
            <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS" prefWidth="420.0">
                <Label styleClass="card-title" text="MOST-USED APPLICATIONS TODAY"/>
                <TableView fx:id="tableTopApps" prefHeight="240.0">
                    <columns>
                        <TableColumn fx:id="colAppName" prefWidth="180.0" text="Application"/>
                        <TableColumn fx:id="colAppDuration" prefWidth="120.0" text="Duration"/>
                        <TableColumn fx:id="colAppCategory" prefWidth="100.0" text="Category"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </HBox>

        <!-- Recent Activities Table & Explainable Insights -->
        <VBox spacing="10.0" styleClass="card">
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label styleClass="card-title" text="RECENT APPLICATION ACTIVITIES"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblProductivityInsight" style="-fx-font-size: 12px; -fx-text-fill: #10B981; -fx-font-weight: 600;" text="✨ Switch between windows to log activity intervals."/>
            </HBox>

            <TableView fx:id="tableRecentActivities" prefHeight="180.0">
                <columns>
                    <TableColumn fx:id="colActApp" prefWidth="200.0" text="Process"/>
                    <TableColumn fx:id="colActTitle" prefWidth="380.0" text="Window Title"/>
                    <TableColumn fx:id="colActDuration" prefWidth="120.0" text="Duration"/>
                    <TableColumn fx:id="colActCategory" prefWidth="120.0" text="Category"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

    </VBox>
</ScrollPane>
