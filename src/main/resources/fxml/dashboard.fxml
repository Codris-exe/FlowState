<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;"
            stylesheets="@../css/flowstate-theme.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.flowstate.ui.DashboardController">

    <VBox spacing="24.0" styleClass="content-area">
        <padding>
            <Insets bottom="32.0" left="28.0" right="28.0" top="16.0"/>
        </padding>

        <!-- Top Greeting Header -->
        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label fx:id="lblGreeting" styleClass="view-title" text="Welcome back!"/>
                <Label fx:id="lblCurrentDate" styleClass="view-subtitle" text="Today is Monday, October 26, 2026"/>
            </VBox>
            <Button onAction="#handleStartFocusSession" styleClass="btn-primary" text="⚡  Start Focus Session"/>
        </HBox>

        <!-- Daily Goal Progress Card -->
        <VBox spacing="10.0" styleClass="card">
            <HBox alignment="CENTER_LEFT">
                <Label styleClass="card-title" text="DAILY FOCUS GOAL"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblGoalProgressText" style="-fx-font-weight: bold; -fx-text-fill: #8B5CF6;" text="0 / 120 mins (0%)"/>
            </HBox>
            <ProgressBar fx:id="pbDailyGoal" maxWidth="Infinity" progress="0.0"/>
        </VBox>

        <!-- 4 Key Stat Metric Cards -->
        <GridPane hgap="16.0" vgap="16.0">
            <!-- Card 1: Today Focus Time -->
            <VBox spacing="6.0" styleClass="card" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS">
                <Label styleClass="card-title" text="TODAY'S FOCUS TIME"/>
                <Label fx:id="lblTodayFocusTime" styleClass="card-value" text="0m"/>
                <Label fx:id="lblFocusSubtext" styleClass="card-subtext" text="Recorded from completed sessions"/>
            </VBox>

            <!-- Card 2: Completed Sessions -->
            <VBox spacing="6.0" styleClass="card" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS">
                <Label styleClass="card-title" text="COMPLETED SESSIONS"/>
                <Label fx:id="lblCompletedSessions" styleClass="card-value" text="0"/>
                <Label styleClass="card-subtext" text="Across all active categories"/>
            </VBox>

            <!-- Card 3: Recorded Interruptions -->
            <VBox spacing="6.0" styleClass="card" GridPane.columnIndex="2" GridPane.hgrow="ALWAYS">
                <Label styleClass="card-title" text="RECORDED INTERRUPTIONS"/>
                <Label fx:id="lblTotalInterruptions" styleClass="card-value" style="-fx-text-fill: #EF4444;" text="0"/>
                <Label styleClass="card-subtext" text="Switches to distracting apps"/>
            </VBox>

            <!-- Card 4: Average Duration -->
            <VBox spacing="6.0" styleClass="card" GridPane.columnIndex="3" GridPane.hgrow="ALWAYS">
                <Label styleClass="card-title" text="AVG SESSION DURATION"/>
                <Label fx:id="lblAvgSessionDuration" styleClass="card-value" text="0m"/>
                <Label styleClass="card-subtext" text="Target average per session"/>
            </VBox>
        </GridPane>

        <!-- Charts and Top Apps Split -->
        <HBox spacing="16.0">
            <!-- 7-Day Focus Time Bar Chart -->
            <VBox spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS" prefWidth="540.0">
                <Label styleClass="card-title" text="FOCUS TIME (LAST 7 DAYS)"/>
                <BarChart fx:id="chartWeeklyFocus" animated="false" legendVisible="false" prefHeight="240.0">
                    <xAxis>
                        <CategoryAxis fx:id="axisDays" side="BOTTOM"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="axisMinutes" label="Minutes" side="LEFT"/>
                    </yAxis>
                </BarChart>
            </VBox>

            <!-- Most-Used Applications -->
            <VBox spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS" prefWidth="420.0">
                <Label styleClass="card-title" text="MOST-USED APPLICATIONS TODAY"/>
                <TableView fx:id="tableTopApps" prefHeight="240.0">
                    <columns>
                        <TableColumn fx:id="colAppName" prefWidth="180.0" text="Application"/>
                        <TableColumn fx:id="colAppDuration" prefWidth="120.0" text="Duration"/>
                        <TableColumn fx:id="colAppCategory" prefWidth="100.0" text="Category"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </HBox>

        <!-- Recent Focus Sessions Table -->
        <VBox spacing="12.0" styleClass="card">
            <HBox alignment="CENTER_LEFT">
                <Label styleClass="card-title" text="RECENT FOCUS SESSIONS"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#handleViewAllSessions" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 4px 10px;" text="View All"/>
            </HBox>
            <TableView fx:id="tableRecentSessions" prefHeight="180.0">
                <columns>
                    <TableColumn fx:id="colSessionTitle" prefWidth="240.0" text="Session Title"/>
                    <TableColumn fx:id="colSessionCategory" prefWidth="120.0" text="Category"/>
                    <TableColumn fx:id="colSessionDuration" prefWidth="120.0" text="Actual Duration"/>
                    <TableColumn fx:id="colSessionInterruptions" prefWidth="120.0" text="Interruptions"/>
                    <TableColumn fx:id="colSessionStatus" prefWidth="110.0" text="Status"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- Explainable Productivity Insights Box -->
        <VBox spacing="8.0" styleClass="card" style="-fx-background-color: #101B2E; -fx-border-color: #3B82F6;">
            <Label style="-fx-text-fill: #3B82F6; -fx-font-weight: bold; -fx-font-size: 13px;" text="💡 PRODUCTIVITY INSIGHT"/>
            <Label fx:id="lblProductivityInsight" style="-fx-text-fill: #F8FAFC; -fx-font-size: 13px; -fx-wrap-text: true;"
                   text="Complete your first focus session to unlock deep-work analytics and interruption patterns!"/>
        </VBox>

    </VBox>
</ScrollPane>
