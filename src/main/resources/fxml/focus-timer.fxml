<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;"
            stylesheets="@../css/flowstate-theme.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.flowstate.ui.FocusTimerController">

    <VBox spacing="20.0" styleClass="content-area">
        <padding>
            <Insets bottom="32.0" left="28.0" right="28.0" top="16.0"/>
        </padding>

        <!-- View Header (Deep Focus Style) -->
        <VBox spacing="4.0">
            <Label styleClass="view-title" text="Focus Session"/>
            <Label styleClass="view-subtitle" text="Set a target, block distractions, and enter deep-work flow."/>
        </VBox>

        <!-- Central Timer Display Card -->
        <VBox alignment="CENTER" spacing="18.0" styleClass="card" style="-fx-padding: 36px 24px;">

            <!-- Status Badge and Active Session Title -->
            <VBox alignment="CENTER" spacing="6.0">
                <HBox alignment="CENTER" spacing="8.0">
                    <Label fx:id="lblSessionStatusBadge" styleClass="date-pill" style="-fx-text-fill: #A78BFA; -fx-border-color: #8B5CF6;" text="READY"/>
                    <Label fx:id="lblActiveCategory" styleClass="date-pill" text="CODING"/>
                </HBox>
                <Label fx:id="lblActiveTitle" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"
                       text="Deep Work Session"/>
            </VBox>

            <!-- Large Digital Clock Display -->
            <StackPane>
                <VBox alignment="CENTER" spacing="2.0">
                    <Label fx:id="lblTimerDisplay" style="-fx-font-size: 76px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF; -fx-font-family: monospace;"
                           text="25:00"/>
                    <Label fx:id="lblTimerSubtext" styleClass="card-subtext"
                           text="Target: 25 minutes  |  Remaining: 25:00"/>
                </VBox>
            </StackPane>

            <!-- Progress Bar -->
            <ProgressBar fx:id="pbSessionProgress" maxWidth="480.0" prefHeight="8.0" progress="0.0"/>

            <!-- Real-Time Metrics Row during Active Session -->
            <HBox fx:id="activeMetricsRow" alignment="CENTER" spacing="36.0" style="-fx-padding: 6px 0;">
                <VBox alignment="CENTER" spacing="2.0">
                    <Label styleClass="card-subtext" text="ELAPSED TIME"/>
                    <Label fx:id="lblElapsedDetail" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;" text="00:00"/>
                </VBox>
                <VBox alignment="CENTER" spacing="2.0">
                    <Label styleClass="card-subtext" text="DISTRACTION SWITCHES"/>
                    <Label fx:id="lblInterruptionCount" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #F87171;" text="0"/>
                </VBox>
            </HBox>

            <!-- Action Controls -->
            <HBox alignment="CENTER" spacing="12.0">
                <!-- Idle Controls -->
                <Button fx:id="btnStartSession" onAction="#handleStartSession" prefWidth="180.0" styleClass="btn-new-session"
                        text="▶  Start Focus Session"/>

                <!-- Active Running Controls -->
                <Button fx:id="btnPauseSession" onAction="#handlePauseSession" prefWidth="120.0" styleClass="btn-secondary"
                        text="⏸  Pause"/>
                <Button fx:id="btnResumeSession" onAction="#handleResumeSession" prefWidth="120.0" styleClass="btn-primary"
                        text="▶  Resume"/>
                <Button fx:id="btnCompleteSession" onAction="#handleCompleteSession" prefWidth="140.0" styleClass="btn-secondary"
                        style="-fx-text-fill: #10B981; -fx-border-color: #10B981;" text="✔  Finish Early"/>
                <Button fx:id="btnCancelSession" onAction="#handleCancelSession" prefWidth="110.0" styleClass="btn-danger"
                        text="✖  Cancel"/>
            </HBox>
        </VBox>

        <!-- Session Configuration Card (Enabled when timer is idle) -->
        <VBox fx:id="configCard" spacing="14.0" styleClass="card">
            <Label styleClass="card-title" text="SESSION GOALS &amp; CONFIGURATION"/>

            <HBox spacing="16.0">
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="card-subtext" text="Session Goal / Title"/>
                    <TextField fx:id="txtSessionTitle" promptText="e.g. Implement Algorithm, Complete Assignment"/>
                </VBox>

                <VBox spacing="6.0" prefWidth="220.0">
                    <Label styleClass="card-subtext" text="Category"/>
                    <ComboBox fx:id="cbSessionCategory" maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <!-- Duration Preset Selectors -->
            <VBox spacing="8.0">
                <Label styleClass="card-subtext" text="Target Duration Presets"/>
                <HBox spacing="10.0">
                    <Button fx:id="btnPreset15" onAction="#handlePreset15" styleClass="btn-secondary" text="15 min (Quick)"/>
                    <Button fx:id="btnPreset25" onAction="#handlePreset25" styleClass="btn-secondary" text="25 min (Pomodoro)"/>
                    <Button fx:id="btnPreset45" onAction="#handlePreset45" styleClass="btn-secondary" text="45 min (Standard)"/>
                    <Button fx:id="btnPreset60" onAction="#handlePreset60" styleClass="btn-secondary" text="60 min (Deep Work)"/>
                </HBox>
            </VBox>
        </VBox>

    </VBox>
</ScrollPane>
