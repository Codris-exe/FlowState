<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;"
            stylesheets="@../css/flowstate-theme.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.flowstate.ui.FocusTimerController">

    <VBox spacing="24.0" styleClass="content-area">
        <padding>
            <Insets bottom="32.0" left="28.0" right="28.0" top="16.0"/>
        </padding>

        <!-- View Header -->
        <VBox spacing="4.0">
            <Label styleClass="view-title" text="Focus Sessions"/>
            <Label styleClass="view-subtitle" text="Set a goal, block distractions, and track deep-work flow."/>
        </VBox>

        <!-- Central Timer Display Card -->
        <VBox alignment="CENTER" spacing="20.0" styleClass="card" style="-fx-padding: 36px 24px; -fx-background-color: #111A2D;">

            <!-- Status Badge and Active Session Title -->
            <VBox alignment="CENTER" spacing="8.0">
                <HBox alignment="CENTER" spacing="8.0">
                    <Label fx:id="lblSessionStatusBadge" style="-fx-background-color: rgba(139, 92, 246, 0.2); -fx-text-fill: #8B5CF6; -fx-padding: 4px 12px; -fx-background-radius: 12px; -fx-font-weight: bold; -fx-font-size: 12px;"
                           text="READY"/>
                    <Label fx:id="lblActiveCategory" style="-fx-background-color: rgba(59, 130, 246, 0.2); -fx-text-fill: #3B82F6; -fx-padding: 4px 12px; -fx-background-radius: 12px; -fx-font-weight: bold; -fx-font-size: 12px;"
                           text="CODING"/>
                </HBox>
                <Label fx:id="lblActiveTitle" style="-fx-font-size: 20px; -fx-font-weight: 600; -fx-text-fill: #F8FAFC;"
                       text="Deep Work Session"/>
            </VBox>

            <!-- Large Digital Clock Display -->
            <StackPane>
                <VBox alignment="CENTER" spacing="4.0">
                    <Label fx:id="lblTimerDisplay" style="-fx-font-size: 72px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC; -fx-font-family: monospace;"
                           text="25:00"/>
                    <Label fx:id="lblTimerSubtext" style="-fx-font-size: 14px; -fx-text-fill: #94A3B8;"
                           text="Target: 25 minutes  |  Remaining: 25:00"/>
                </VBox>
            </StackPane>

            <!-- Progress Bar -->
            <ProgressBar fx:id="pbSessionProgress" maxWidth="480.0" prefHeight="12.0" progress="0.0"/>

            <!-- Real-Time Metrics Row during Active Session -->
            <HBox fx:id="activeMetricsRow" alignment="CENTER" spacing="32.0" style="-fx-padding: 8px 0;">
                <VBox alignment="CENTER" spacing="2.0">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #64748B;" text="ELAPSED TIME"/>
                    <Label fx:id="lblElapsedDetail" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;" text="00:00"/>
                </VBox>
                <VBox alignment="CENTER" spacing="2.0">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #64748B;" text="INTERRUPTIONS"/>
                    <Label fx:id="lblInterruptionCount" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #EF4444;" text="0"/>
                </VBox>
            </HBox>

            <!-- Action Controls -->
            <HBox alignment="CENTER" spacing="16.0">
                <!-- Idle Controls -->
                <Button fx:id="btnStartSession" onAction="#handleStartSession" prefWidth="180.0" styleClass="btn-primary"
                        text="▶  Start Focus Session"/>

                <!-- Active Running Controls -->
                <Button fx:id="btnPauseSession" onAction="#handlePauseSession" prefWidth="130.0" styleClass="btn-secondary"
                        text="⏸  Pause"/>
                <Button fx:id="btnResumeSession" onAction="#handleResumeSession" prefWidth="130.0" styleClass="btn-primary"
                        text="▶  Resume"/>
                <Button fx:id="btnCompleteSession" onAction="#handleCompleteSession" prefWidth="150.0" styleClass="btn-success"
                        text="✔  Finish Early"/>
                <Button fx:id="btnCancelSession" onAction="#handleCancelSession" prefWidth="120.0" styleClass="btn-danger"
                        text="✖  Cancel"/>
            </HBox>
        </VBox>

        <!-- Session Configuration Card (Enabled when timer is idle) -->
        <VBox fx:id="configCard" spacing="16.0" styleClass="card">
            <Label styleClass="card-title" text="SESSION SETTINGS"/>

            <HBox spacing="16.0">
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;" text="Session Title / Goal"/>
                    <TextField fx:id="txtSessionTitle" promptText="e.g. Implement PostgreSQL Repository Layer"/>
                </VBox>

                <VBox spacing="6.0" prefWidth="220.0">
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;" text="Category"/>
                    <ComboBox fx:id="cbCategory" maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <VBox spacing="8.0">
                <Label style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;" text="Target Duration"/>
                <HBox spacing="12.0">
                    <Button onAction="#handlePreset15" styleClass="btn-secondary" text="15 min"/>
                    <Button onAction="#handlePreset25" styleClass="btn-secondary" text="25 min (Pomodoro)"/>
                    <Button onAction="#handlePreset45" styleClass="btn-secondary" text="45 min"/>
                    <Button onAction="#handlePreset60" styleClass="btn-secondary" text="60 min"/>
                    <Button onAction="#handlePreset90" styleClass="btn-secondary" text="90 min (Ultra)"/>
                </HBox>
            </VBox>
        </VBox>

    </VBox>
</ScrollPane>
