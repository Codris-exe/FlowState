<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:id="mainRoot" prefHeight="760.0" prefWidth="1200.0" styleClass="app-window"
            stylesheets="@../css/flowstate-theme.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.flowstate.ui.NavigationController">

    <!-- Persistent Left Sidebar (Deep Focus / RIZE Minimal Style) -->
    <left>
        <VBox prefWidth="240.0" spacing="8.0" styleClass="sidebar">
            <padding>
                <Insets bottom="20.0" left="16.0" right="16.0" top="24.0"/>
            </padding>

            <!-- Brand Header -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label style="-fx-font-size: 20px;" text="🌊"/>
                <Label styleClass="brand-title" text="FlowState"/>
            </HBox>

            <Region prefHeight="16.0"/>

            <!-- Sidebar Navigation Category Header -->
            <Label styleClass="sidebar-section-header" text="NAVIGATION"/>

            <!-- Core 3 Navigation Items -->
            <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                <Button fx:id="btnDashboard" maxWidth="Infinity" onAction="#handleNavDashboard"
                        styleClass="nav-button, active" text="📊  Dashboard"/>

                <Button fx:id="btnActivityMonitor" maxWidth="Infinity" onAction="#handleNavActivityMonitor"
                        styleClass="nav-button" text="🌐  Activity Timeline"/>

                <Button fx:id="btnAnalytics" maxWidth="Infinity" onAction="#handleNavAnalytics"
                        styleClass="nav-button" text="📈  Analytics"/>
            </VBox>

            <!-- Bottom Background Tracking Status -->
            <VBox spacing="8.0" styleClass="card" style="-fx-padding: 12px; -fx-background-color: #101117;">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Circle fx:id="trackingStatusDot" fill="#10B981" radius="4.0"/>
                    <Label fx:id="lblTrackingStatus" style="-fx-font-size: 12px; -fx-text-fill: #9CA3AF; -fx-font-weight: 600;"
                           text="Tracking: Active"/>
                </HBox>
                <Button fx:id="btnToggleTracking" maxWidth="Infinity" onAction="#handleToggleTracking"
                        styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 5px 10px;"
                        text="Pause Tracking"/>
            </VBox>
        </VBox>
    </left>

    <!-- Main Content Container -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area"/>
    </center>

</BorderPane>
