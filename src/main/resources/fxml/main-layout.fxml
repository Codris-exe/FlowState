<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:id="mainRoot" prefHeight="760.0" prefWidth="1180.0" styleClass="app-window"
            stylesheets="@../css/flowstate-theme.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.flowstate.ui.NavigationController">

    <!-- Persistent Left Sidebar -->
    <left>
        <VBox prefWidth="250.0" spacing="8.0" styleClass="sidebar">
            <padding>
                <Insets bottom="20.0" left="16.0" right="16.0" top="24.0"/>
            </padding>

            <!-- Brand Header -->
            <VBox spacing="4.0">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label styleClass="brand-title" text="FlowState"/>
                    <Label styleClass="brand-badge" text="PRO"/>
                </HBox>
                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px;" text="Smart Productivity Analyzer"/>
            </VBox>

            <Region prefHeight="16.0"/>

            <!-- Navigation Buttons -->
            <VBox spacing="4.0" VBox.vgrow="ALWAYS">
                <Button fx:id="btnDashboard" maxWidth="Infinity" onAction="#handleNavDashboard"
                        styleClass="nav-button, active" text="📊  Dashboard"/>

                <Button fx:id="btnFocusSessions" maxWidth="Infinity" onAction="#handleNavFocusSessions"
                        styleClass="nav-button" text="⏱  Focus Sessions"/>

                <Button fx:id="btnActivityMonitor" maxWidth="Infinity" onAction="#handleNavActivityMonitor"
                        styleClass="nav-button" text="🖥  Activity Monitor"/>

                <Button fx:id="btnAnalytics" maxWidth="Infinity" onAction="#handleNavAnalytics"
                        styleClass="nav-button" text="📈  Analytics"/>

                <Button fx:id="btnSessionHistory" maxWidth="Infinity" onAction="#handleNavSessionHistory"
                        styleClass="nav-button" text="📜  Session History"/>

                <Button fx:id="btnReports" maxWidth="Infinity" onAction="#handleNavReports"
                        styleClass="nav-button" text="📁  Reports &amp; Export"/>

                <Button fx:id="btnSettings" maxWidth="Infinity" onAction="#handleNavSettings"
                        styleClass="nav-button" text="⚙  Settings"/>
            </VBox>

            <!-- Bottom Tracking Status Card -->
            <VBox spacing="10.0" styleClass="card" style="-fx-padding: 12px; -fx-background-color: #0A0F1D;">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Circle fx:id="trackingStatusDot" fill="#10B981" radius="4.0"/>
                    <Label fx:id="lblTrackingStatus" style="-fx-font-size: 12px; -fx-text-fill: #94A3B8; -fx-font-weight: 600;"
                           text="Tracking: Active"/>
                </HBox>
                <Button fx:id="btnToggleTracking" maxWidth="Infinity" onAction="#handleToggleTracking"
                        styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 6px 10px;"
                        text="Pause Tracking"/>
            </VBox>
        </VBox>
    </left>

    <!-- Main Content Container -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area"/>
    </center>

</BorderPane>
